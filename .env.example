# Скопируйте этот файл в .env и впишите свой токен.
# Токен выдаёт @BotFather в Telegram: /newbot -> имя -> username бота.
BOT_TOKEN=

# Кто может пользоваться ботом: id или @username через запятую. Пусто — все.
ALLOWED_USERS=
# Администраторы (команды /stats и /export): id или @username через запятую.
ADMIN_IDS=

# Где хранить базу SQLite со всеми запросами.
DB_PATH=data/flowgen_bot.sqlite3

# Ограничения
MAX_FILE_KB=300
MAX_FUNCTIONS=40
PER_MINUTE=6
TIMEOUT_S=90
WORKERS=2

# Свой сервер Bot API (обычно не нужен)
TELEGRAM_API_URL=
